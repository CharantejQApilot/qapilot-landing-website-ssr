# Copy to .env.local and fill in values from Supabase → Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# These drive all server + client Supabase access, Next/Image host allowlist,
# layout preconnect, /robots.txt, and /sitemap-index.xml Edge Function URLs.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only: local scripts (e.g. npm run create-admin). Never expose in the browser or NEXT_PUBLIC_*.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Secret used by `/api/revalidate/db-webhook` for DB-trigger cache invalidation.
# Set this in Vercel/Next runtime env AND store the same value in Supabase Vault
# secret name `cms_revalidate_webhook_secret`.
# CMS_REVALIDATE_WEBHOOK_SECRET=generate-a-long-random-secret
#
# Claude content automation (POST /api/media, POST /api/posts, PATCH /api/posts/:id)
# CMS_API_TOKEN=generate-a-long-random-secret

# After creating a new project, redeploy Edge Functions from supabase/functions
# (sitemap-posts, sitemap-news, sitemap-jobs, prerender-meta, ping-sitemap, etc.)
# and set their secrets (SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY) in the dashboard.
